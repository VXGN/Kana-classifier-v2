   "source": [
    "def grid(dt, ttl, r, c, h = False, rh = [0, 1], xlim=None):\n",
    "    _, ax = plt.subplots(r, c, figsize=(12, 12))\n",
    "    if r == 1 and c == 1:\n",
    "        ax = np.array([[ax]])\n",
    "    elif r == 1:\n",
    "        ax = ax.reshape(1, -1)\n",
    "    elif c == 1:\n",
    "        ax = ax.reshape(-1, 1)\n",
    "    \n",
    "    for i in range(r):\n",
    "        for j in range(c):\n",
    "            idx = i * c + j\n",
    "            if idx < len(dt):\n",
    "                ax[i, j].imshow(dt[idx], cmap='gray')\n",
    "                ax[i, j].axis('off')\n",
    "                if h:\n",
    "                    ax[i * 2 + 1, j].hist(dt[idx].ravel(), 256, rh, orientation='horizontal')\n",
    "                    ax[i * 2 + 1, j].set_xlim(xlim)\n",
    "                if j == 0:\n",
    "                    if isinstance(ttl, list):\n",
    "                        ax[i, j].set_title(ttl[i])\n",
    "                    else:\n",
    "                        ax[i, j].set_title(ttl)\n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
  },
