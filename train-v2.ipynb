    "from concurrent.futures import ThreadPoolExecutor, as_completed\n",
    "import tqdm\n",
    "\n",
    "def load_image(args):\n",
    "    idx, im, ims, c = args\n",
    "    img = cv2.resize(cv2.imread(im, cv2.IMREAD_GRAYSCALE), ims)\n",
    "    label = c.index(os.path.basename(os.path.dirname(im)))\n",
    "    return idx, img, label, os.path.basename(os.path.dirname(im))\n",
    "\n",
    "d = []\n",
    "l = []\n",
    "\n",
    "with ThreadPoolExecutor(max_workers=14) as executor:\n",
    "    futures = {executor.submit(load_image, (idx, im, ims, category)): im for idx, im in enumerate(image_paths)}\n",
    "    \n",
    "    for future in tqdm.tqdm(as_completed(futures), total=len(futures)):\n",
    "        idx, img, label, cat_name = future.result()\n",
    "        d.append(img)\n",
    "        l.append(label)\n",
    "\n",
    "labels = np.array(l)"
   ]
  },
